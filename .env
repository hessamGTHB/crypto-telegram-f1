# ============================================================
#  تنظیمات ربات قیمت ارز دیجیتال
#  این فایل را به `.env` تغییر نام دهید و مقادیر را پر کنید.
# ============================================================

# توکن ربات — از @BotFather بگیرید (الزامی)
BOT_TOKEN=9086350129:AAFBeEznUyD0l3RWdRQeL-Scoi8541JPS-s

# آی‌دی عددی مدیران ربات، جدا شده با کاما (قویاً توصیه می‌شود)
# آی‌دی خودتان را از @userinfobot بگیرید.
# اگر خالی بماند، هر کسی که در چت خصوصی به ربات پیام دهد مدیر در نظر گرفته می‌شود!
ADMIN_IDS=6535419362

# کانال پیش‌فرض برای ارسال پست‌ها (اختیاری)
# می‌تواند @نام‌کانال یا آی‌دی عددی مثل -1001234567890 باشد.
# بعداً هم می‌توانید با دستور /channel آن را تغییر دهید.
CHANNEL_ID=@dfgrew3rd

# زبان پیش‌فرض پست‌ها و ربات:  fa / en / zh / ja / ko / hi
DEFAULT_LANGUAGE=fa

# فاصله ارسال خودکار پست به دقیقه (بین ۱۰ تا ۱۴۴۰)
POST_INTERVAL_MINUTES=60

# منطقه زمانی برای نمایش تاریخ و ساعت در پست‌ها
TIMEZONE=Asia/Tehran

# کلید API کوین‌گکو (اختیاری — فقط اگر به نرخ درخواست بالاتر نیاز دارید)
COINGECKO_API_KEY=

# امضای انتهای پست‌ها؛ مثلاً آی‌دی کانال یا ربات شما (اختیاری)
FOOTER_TEXT=@dfgrew3rd

# حداکثر تعداد ارزی که می‌توان به لیست اضافه کرد (۱ تا ۳۰)
MAX_COINS=15
